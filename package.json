{
  "name": "hartiromania",
  "version": "1.12.0",
  "private": true,
  "description": "Hărți istorice românești, cărți și vederi de colecție — site de prezentare hartiromania.ro",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"lib/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "studio:dev": "sanity dev",
    "studio:deploy": "sanity deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@portabletext/to-html": "^6.0.0",
    "@radix-ui/react-slot": "latest",
    "@sanity/client": "^8.16.0",
    "@sanity/vision": "^6.23.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "latest",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "6.38.0",
    "sanity": "^6.23.0",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3"
  }
}
